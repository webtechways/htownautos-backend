  copartId          String? // "Id"
  yardNumber        String? // "Yard number"
  yardName          String? // "Yard name"
  saleDate          String? // "Sale Date M/D/CY"
  dayOfWeek         String? // "Day of Week"
  saleTime          String? // "Sale time (HHMM)"
  timeZone          String? // "Time Zone"
  itemNumber        String? // "Item#"
  lotNumber         String? // "Lot number"
  vehicleType       String? // "Vehicle Type"
  year              String? // "Year"
  make              String? // "Make"
  modelGroup        String? // "Model Group"
  modelDetail       String? // "Model Detail"
  bodyStyle         String? // "Body Style"
  color             String? // "Color"
  damageDescription String? // "Damage Description"
