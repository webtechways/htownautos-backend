  // draft | pending_payment | paid | ready_to_ship | shipped | delivered | cancelled | refunded

  subtotal     Decimal @default(0) @db.Decimal(10, 2)
  taxRate      Decimal @default(0) @db.Decimal(6, 4)
  tax          Decimal @default(0) @db.Decimal(10, 2)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @default(0) @db.Decimal(10, 2)

  // Payment
  paymentMethod         String? // stripe | cash | manual | other
  paymentStatus         String    @default("unpaid") // unpaid | processing | paid | refunded | failed
  stripePaymentIntentId String?
  stripeChargeId        String?
  paidAt                DateTime?

  // Shipping
  shippingMethod String? // pickup | ship
  shipToName     String?
  shipToStreet1  String?
  shipToStreet2  String?
  shipToCity     String?
  shipToState    String?
  shipToZip      String?
  shipToCountry  String? @default("US")
  shipToPhone    String?
  shipToEmail    String?

