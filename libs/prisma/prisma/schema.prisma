  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("activity_types")
}

model ActivityStatus {
  id         String     @id @default(uuid())
  slug       String
  title      String
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  tenantId   String?
  activities Activity[]
