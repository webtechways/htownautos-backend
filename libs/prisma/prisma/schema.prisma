model FuelType {
  id        String    @id @default(uuid())
  slug      String    @unique
  title     String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  Vehicle[]

  @@map("fuel_types")
}

model DriveType {
  id        String    @id @default(uuid())
  slug      String    @unique
  title     String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  Vehicle[]

  @@map("drive_types")
}

model TransmissionType {
  id        String    @id @default(uuid())
  slug      String    @unique
  title     String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
