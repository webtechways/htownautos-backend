/// Learned mapping of a raw Copart `saleTitleType` code → primary title
/// category. Seeded empty; staff assign unknown codes from the auction listing
/// UI and every lot with that code is categorized accordingly from then on.
model AuctionTitleTypeMapping {
  code         String   @id // lowercased raw saleTitleType code
  category     String // clean | nonrepairable | salvage
  assignedById String? // Clerk user id of the staff member who assigned it
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("auction_title_type_mappings")
}

/// Staff-curated alias → canonical value for auction filter fields (make / model
/// / trim / color), managed from Settings → Vehicle Data. `aliasKey` is a
/// normalizeToken() variant seen in the feed; `canonical` is the UPPERCASE value
/// it should collapse into (e.g. "PRO MASTER" → "PROMASTER"). Auto-seeded by the
/// sync (reviewed=false, canonical=identity) which notifies staff to merge them.
/// Read live (cached) by ingestion, facets and matching — no reindex to apply.
model AuctionValueAlias {
  id           String   @id @default(uuid())
  field        String // make | model | trim | color
  aliasKey     String // normalizeToken(raw) — the variant as seen
  canonical    String // UPPERCASE canonical value staff chose
  reviewed     Boolean  @default(false)
  assignedById String? // Clerk user id of the staff member who set it
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([field, aliasKey])
  @@index([field, reviewed])
  @@map("auction_value_aliases")
}

/// Staff-curated seller trust + Source classification, managed from
/// Settings → Sellers. Replaces the fixed deriveSellerCategory heuristic for the
/// "Trusted Seller" matching filter and the Source facet. Rows are auto-seeded by
/// the sync for any new sellerName (reviewed=false) which triggers a staff
/// notification to classify them. Global (auction data is shared across tenants).
model AuctionSellerClassification {
  sellerKey    String   @id // lowercased + trimmed sellerName (stable key)
  sellerName   String // display casing as seen on lots
  category     String // Insurance | Rental | Repo | Other (override)
  /// low | medium | high. Sustituye al booleano `trusted`, que metia en el
  /// mismo saco a una aseguradora y a un desguace por no ser ninguno "de fiar".
  /// Lo desconocido cae en `high` a proposito.
  riskLevel    String   @default("high")
  /// Derivado de riskLevel (low => true). Se conserva para no romper el
  /// matching de compradores mientras migra al filtro por riesgo.
  trusted      Boolean  @default(false)
  reviewed     Boolean  @default(false) // false = auto-seeded by sync, needs staff review
  assignedById String? // Clerk user id of the staff member who classified it
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([reviewed])
  @@index([trusted])
  @@index([riskLevel])
  @@map("auction_seller_classifications")
}

