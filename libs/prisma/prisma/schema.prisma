generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SaleType {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sale_types")
}

model MileageStatus {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mileage_statuses")
}

model VehicleStatus {
  id        String    @id @default(uuid())
  slug      String
  title     String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles  Vehicle[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("vehicle_statuses")
}

model TitleStatus {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  titles    Title[]

  @@map("title_statuses")
}

model VehicleCondition {
  id        String    @id @default(uuid())
  slug      String    @unique
  title     String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  Vehicle[]

  @@map("vehicle_conditions")
}

model BrandStatus {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  titles    Title[]

  @@map("brand_statuses")
}

model VehicleType {
  id        String    @id @default(uuid())
  slug      String    @unique
  title     String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  Vehicle[]

  @@map("vehicle_types")
}

model BodyType {
  id           String        @id @default(uuid())
  slug         String        @unique
  title        String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
