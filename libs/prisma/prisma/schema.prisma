  @@index([tenantId])
  @@index([vehicleId])
  @@index([buyerId])
  @@index([partId])
  @@index([mediaType])
  @@index([category])
  @@index([isActive])
  @@index([inspectionId])
  @@index([inspectionChecklistItemId])
  @@index([inspectionRequestItemId])
  @@index([inspectionErrorCodeId])
  @@index([carfaxReportId])
  @@map("media")
}

