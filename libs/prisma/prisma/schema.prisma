/// Learned mapping of a raw Copart `saleTitleType` code → primary title
/// category. Seeded empty; staff assign unknown codes from the auction listing
/// UI and every lot with that code is categorized accordingly from then on.
model AuctionTitleTypeMapping {
  code         String   @id // lowercased raw saleTitleType code
  category     String // clean | nonrepairable | salvage
  assignedById String? // Clerk user id of the staff member who assigned it
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("auction_title_type_mappings")
}

/// Staff-curated alias → canonical value for auction filter fields (make / model
/// / trim / color), managed from Settings → Vehicle Data. `aliasKey` is a
/// normalizeToken() variant seen in the feed; `canonical` is the UPPERCASE value
/// it should collapse into (e.g. "PRO MASTER" → "PROMASTER"). Auto-seeded by the
/// sync (reviewed=false, canonical=identity) which notifies staff to merge them.
/// Read live (cached) by ingestion, facets and matching — no reindex to apply.
model AuctionValueAlias {
  id           String   @id @default(uuid())
  field        String // make | model | trim | color
  aliasKey     String // normalizeToken(raw) — the variant as seen
  canonical    String // UPPERCASE canonical value staff chose
  reviewed     Boolean  @default(false)
  assignedById String? // Clerk user id of the staff member who set it
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([field, aliasKey])
  @@index([field, reviewed])
  @@map("auction_value_aliases")
}

/// Staff-curated seller trust + Source classification, managed from
/// Settings → Sellers. Replaces the fixed deriveSellerCategory heuristic for the
/// "Trusted Seller" matching filter and the Source facet. Rows are auto-seeded by
/// the sync for any new sellerName (reviewed=false) which triggers a staff
/// notification to classify them. Global (auction data is shared across tenants).
model AuctionSellerClassification {
  sellerKey    String   @id // lowercased + trimmed sellerName (stable key)
  sellerName   String // display casing as seen on lots
  category     String // Insurance | Rental | Repo | Other (override)
  /// low | medium | high. Sustituye al booleano `trusted`, que metia en el
  /// mismo saco a una aseguradora y a un desguace por no ser ninguno "de fiar".
  /// Lo desconocido cae en `high` a proposito.
  riskLevel    String   @default("high")
  /// Derivado de riskLevel (low => true). Se conserva para no romper el
  /// matching de compradores mientras migra al filtro por riesgo.
  trusted      Boolean  @default(false)
  reviewed     Boolean  @default(false) // false = auto-seeded by sync, needs staff review
  assignedById String? // Clerk user id of the staff member who classified it
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([reviewed])
  @@index([trusted])
  @@index([riskLevel])
  @@map("auction_seller_classifications")
}

model AuctionListing {
  auctionName           String?                   @default("Copart")
  copartId              Int?
  yardNumber            Int?
  yardName              String?
  saleDate              Int?
  dayOfWeek             String?
  saleTime              String?
  timeZone              String?
  itemNumber            Int?
  lotNumber             BigInt                    @id
  vehicleType           String?
  year                  Int?
  make                  String?
  modelGroup            String?
  modelDetail           String?
  bodyStyle             String?
  color                 String?
  damageDescription     String?
  secondaryDamage       String?
  saleTitleState        String?
  saleTitleType         String?
  hasKeys               String?
  lotCondCode           String?
  vin                   String?
  odometer              Decimal?                  @db.Decimal(12, 1)
  odometerBrand         String?
  estRetailValue        Decimal?                  @db.Decimal(12, 2)
  repairCost            Decimal?                  @db.Decimal(12, 2)
  engine                String?
  drive                 String?
  transmission          String?
  fuelType              String?
  cylinders             String?
  runsDrives            String?
  saleStatus            String?
  highBid               Decimal?                  @db.Decimal(12, 2)
  specialNote           String?
  locationCity          String?
  locationState         String?
  locationZip           String?
  locationCountry       String?
  currencyCode          String?
  images                String?
  galleryCache          String?                   @db.Text
  galleryCachedAt       DateTime?
  createDateTime        String?
  gridRow               String?
  makeOfferEligible     String?
  buyItNowPrice         Decimal?                  @db.Decimal(12, 2)
  trim                  String?
  lastUpdatedTime       DateTime?
  rentals               String?
  wholesale             String?
  sellerName            String?
  offsiteAddress1       String?
  offsiteState          String?
  offsiteCity           String?
  offsiteZip            String?
  saleLight             String?
  autoGrade             String?
  announcements         String?
  // Derived at import time (see copart-import.service.ts) — kept in sync with
  // the OpenSearch document so both backends filter identically.
  sellerCategory        String? // Insurance | Rental | Repo | Other
  engineSizeL           Decimal?                  @db.Decimal(4, 1)
  locationLat           Float?
  locationLng           Float?
  // Canonical (deduped, UPPERCASE) filter values — derived from make / modelGroup
  // / trim / color via normalizeToken + the AuctionValueAlias overrides. Facets,
  // aggregations and buyer matching all read these so every surface agrees.
  makeCanonical         String?
  modelCanonical        String?
  trimCanonical         String?
  colorCanonical        String?
  // Freshness tracking — updated every sync run when the lot appears in the feed.
  // Listings whose lastSeenAt is older than the staleness threshold get isStale=true.
  lastSeenAt            DateTime?
  isStale               Boolean                   @default(false)
  // Staff-marked "discarded" — a lot already evaluated/inspected that should be
  // skipped next time it appears, with the reason recorded.
  discarded             Boolean                   @default(false)
  discardReason         String?
  discardedAt           DateTime?
  discardedById         String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  analyses              AuctionVehicleAnalysis[]
  damageAnalyses        LotDamageAnalysis[]
  marketParts           VehicleMarketPart[]
  carfaxReports         CarfaxReport[]
  maxBidRecommendations MaxBidRecommendation[]
  listingGroupItems     AuctionListingGroupItem[]
  reviews               AuctionListingReview[]
  buyerBids             BuyerAuctionBid[]
  analysisSnapshots     AuctionAnalysisSnapshot[]

  // Normalized link to the Yard. yardName / yardNumber stay as a cache
  // (Copart's CSV import writes them directly) but yardId is the source
  // of truth for relations.
  yardId String?
  yard   Yard?   @relation(fields: [yardId], references: [id], onDelete: SetNull)

  @@index([auctionName])
  @@index([vin])
  @@index([year])
  @@index([make])
  @@index([saleDate])
  @@index([saleStatus])
  @@index([locationState])
  @@index([damageDescription])
  @@index([createdAt])
  /// MAX(updatedAt) lo pide el dashboard en cada arranque. Sin indice son
  /// 300k filas escaneadas con sus columnas JSON detras.
  @@index([updatedAt])
  @@index([isStale])
  @@index([lastSeenAt])
  @@index([yardId])
  @@index([discarded])
  @@index([sellerCategory])
  @@index([makeCanonical])
  @@index([modelCanonical])
  @@index([trimCanonical])
  @@index([colorCanonical])
  @@index([saleTitleType])
  @@index([locationLat, locationLng])
  @@map("auction_listings")
}

enum AuctionAnalysisType {
  MARKET_CHECK // MarketCheck price/MSRP snapshot
  COMPARABLES // MarketCheck comparable listings snapshot
  AUCTION_HISTORY // Vehicle Databases auction sale history snapshot
}

/// Persisted snapshot of an otherwise live-only auction analysis (MarketCheck
/// price, comparables, auction history) generated by staff in the dashboard, so
/// the read-only inspection views (web + share link) can show what was generated
/// without re-calling the paid external APIs. One row per (listing, type), upserted.
model AuctionAnalysisSnapshot {
  id               String              @id @default(uuid())
  auctionListingId BigInt
  type             AuctionAnalysisType
  data             Json
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  auctionListing AuctionListing @relation(fields: [auctionListingId], references: [lotNumber], onDelete: Cascade)

  @@unique([auctionListingId, type])
  @@index([auctionListingId])
  @@map("auction_analysis_snapshots")
}

/// Post-sale auction outcome per lot, ingested from an external scraper of the
/// live-sale pages (final bid / asking / reserve / sold). Each row is a MERGE
/// of the incoming sale data + a frozen snapshot of the vehicle pulled from
/// auction_listings by lot number at ingest time — so it stays complete for
/// statistics even after the listing expires from the feed. Intentionally
/// DECOUPLED: `lot` is a plain indexed column (no FK), because a lot recurs
/// across different sale days (re-auctioned when reserve isn't met) and the
/// history must survive listing deletion. Dedupe key is (lot, saleDate).
model AuctionSaleResult {
  id  String @id @default(uuid())
  lot BigInt // Copart lot number (no FK — decoupled from auction_listings)

  // ── Incoming sale/auction data ──
  saleDate         Int? // YYYYMMDD (parsed from pageUrl, fallback to receivedAt)
  auctionSession   String? // e.g. "copart-882-a"
  saleLocationSlug String? // e.g. "ncs-mountain_region"
  finalBid         Decimal?  @db.Decimal(12, 2)
  askingPrice      Decimal?  @db.Decimal(12, 2)
  reserve          Boolean?
  sold             Boolean?
  ticks            Int?
  round            Int?
  saleOrder        Int? // the "order" field
  event            String?
  pageUrl          String?
  receivedAt       DateTime?

  // ── Datos que solo trae el frame de Solace ──
  /// Sala tal cual la nombra Copart, p.ej. `COPART024A`.
  saleRoom        String?
  /// `MINMET`: si la reserva quedo cubierta.
  reserveMet      Boolean?
  /// `APRFLG`: venta aprobada.
  approved        Boolean?
  buyerNo         String?
  /// `BUYERST` no es del mismo tipo siempre: "NJ" en EE.UU., "19" en
  /// internacionales. Se guarda como texto y ya.
  buyerState      String?
  buyerCountry    String?
  itemNo          Int?
  /// Instante en que Copart emitio el evento, distinto de cuando nos llego.
  emittedAt       DateTime?
  /// SOLDPEND: adjudicada pero a la espera de que el vendedor acepte la puja.
  /// Un SOLD posterior del mismo lote la confirma y esto pasa a false.
  pendingApproval Boolean?

  // ── Vehicle snapshot promoted from auction_listings (for fast stats) ──
  matched           Boolean  @default(false) // was the lot found in auction_listings?
  vin               String?
  year              Int?
  make              String?
  model             String? // modelGroup
  modelDetail       String?
  trim              String?
  bodyStyle         String?
  color             String?
  damageDescription String?
  secondaryDamage   String?
  saleTitleType     String?
  saleTitleState    String?
  odometer          Decimal? @db.Decimal(12, 1)
  runsDrives        String?
  engine            String?
  transmission      String?
  drive             String?
  fuelType          String?
  cylinders         String?
  estRetailValue    Decimal? @db.Decimal(12, 2)
  repairCost        Decimal? @db.Decimal(12, 2)
  highBidAtSync     Decimal? @db.Decimal(12, 2) // AuctionListing.highBid at ingest
  yardNumber        Int?
  yardName          String?
  locationCity      String?
  locationState     String?
  locationZip       String?
  sellerName        String?
  sellerCategory    String?

  // ── Full payloads (future-proofing / audit) ──
  vehicleSnapshot Json? // complete auction_listings row, JSON-safe serialized
  raw             Json? // original incoming item

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lot, saleDate])
  @@index([lot])
  @@index([saleDate])
  @@index([saleRoom])
  @@index([sold])
  @@index([make])
  @@index([year])
  @@index([yardNumber])
  @@index([saleTitleType])
  @@index([sellerCategory])
  @@map("auction_sale_results")
}

enum YardSource {
  COPART
  IAAI
  OTHER
}

/// Physical auction yard. One row per (source, yardNumber). Carries
/// operational metadata that's not in the Copart CSV — address,
/// contact, ops notes, and the critical `physicalInspectionAvailable`
/// flag that the inspector workflow keys off.
// Cada puja de una subasta en vivo (evento BIDREC).
//
// Tabla aparte de auction_sale_results a proposito: un lote tiene UNA venta pero
// MUCHAS pujas. Meterlas en la misma fila —que es unica por (lot, saleDate)— o
// sobrescribiria el resultado en cada puja o rompelia la restriccion.
model AuctionBidEvent {
  id  String @id @default(uuid())
  lot BigInt

  /// BIDREC (puja en vivo) o PREBID (puja previa al remate). Son la misma
  /// forma de dato pero no valen lo mismo: una preventa no es una puja en sala.
  eventType String @default("BIDREC")

  saleRoom  String?
  itemNo    Int?
  /// `CURBID`: lo que se ha pujado.
  bid       Decimal? @db.Decimal(12, 2)
  /// `ASKBID`: lo que se esta pidiendo.
  askBid    Decimal? @db.Decimal(12, 2)
  nextBid   Decimal? @db.Decimal(12, 2)
  increment Decimal? @db.Decimal(12, 2)

  reserveMet   Boolean?
  approved     Boolean?
  buyerNo      String?
  buyerState   String?
  buyerCountry String?

  /// Cuando lo emitio Copart, no cuando nos llego.
  emittedAt  DateTime?
  receivedAt DateTime  @default(now())

  raw Json?

  /// Idempotencia: el mismo evento reenviado por dos VM no duplica fila. El
  /// tipo entra en la clave porque una PREBID y una BIDREC pueden coincidir en
  /// instante e importe y son eventos distintos.
  @@unique([lot, eventType, emittedAt, bid])
  @@index([lot])
  @@index([saleRoom])
  @@index([emittedAt])
  @@index([eventType])
  @@map("auction_bid_events")
}

// Frame crudo tal como llego, antes de decodificar.
//
// Es lo que permite reprocesar el pasado: si dentro de un mes resulta que un
// campo que hoy ignoramos significa algo, se relanza el parser sobre lo ya
// guardado. Decodificar y tirar el original pierde para siempre lo que no se
// entendio en su momento, y estos eventos no se repiten.
model AuctionRawFrame {
  id String @id @default(uuid())

  /// El frame en base64, tal cual lo capturo la extension.
  frame  String  @db.Text
  /// De que VM vino, para poder aislar una maquina que mande basura.
  worker String?

  /// pending | processed | failed | ignored
  status  String  @default("pending")
  /// Que salio al decodificarlo, para no tener que repetirlo en la UI.
  event   String?
  lot     BigInt?
  error   String?
  /// Lo decodificado, para poder verlo en el Live Feed sin cruzar tablas.
  /// Se rellena tambien en los `ignored`: un evento que aun no tratamos se
  /// entiende mirando sus datos, no su nombre.
  summary Json?

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
  @@index([receivedAt])
  @@index([lot])
  /// La purga filtra por los dos a la vez; con indices sueltos Postgres solo
  /// aprovecha uno y cada pasada acaba siendo un escaneo.
  @@index([status, receivedAt])
  @@map("auction_raw_frames")
}

model Yard {
  id         String     @id @default(uuid())
  source     YardSource
  yardNumber Int
  name       String
  // Public catalog slug from the source auction site (e.g. "tx-houston").
  // Backfilled from the AutoBidMaster/Copart locations dump, matched by
  // (source, yardNumber). Nullable + unique so future yards can add it later.
  slug       String?    @unique

  // Location / contact
  address     String?
  city        String?
  state       String?
  zip         String?
  country     String? @default("US")
  latitude    Float?
  longitude   Float?
  phone       String?
  email       String?
  contactName String?

  // Ops
  // Whether we (or our partner network) physically visit this yard
  // to inspect cars. Drives the inspection-request UI.
  physicalInspectionAvailable Boolean @default(false)
  // Loose JSON for opening hours (e.g. { mon: "9-17", sat: "closed" }).
  // Kept Json on purpose so we don't lock the shape too early.
  hours                       Json?
  // Internal notes: access instructions, key handling, photo policy, etc.
  notes                       String?
  // Per-yard travel/transport fee in cents charged on each inspection order.
  travelFeeCents              Int     @default(5000)
  // Minimum number of cars required per inspection visit to this yard.
  minCars                     Int     @default(1)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auctionListings AuctionListing[]
  inspections     VehicleInspection[]

  @@unique([source, yardNumber])
  @@index([state])
  @@index([physicalInspectionAvailable])
  @@index([isActive])
  @@map("yards")
}

/// Audit trail for every sync cron run. One row per invocation (including skipped
/// runs), lets us answer "when did the last sync succeed?" and "why did it fail?"
/// without scraping container logs.
model SyncRun {
  id              String    @id @default(uuid()) @db.Uuid
  source          String // "copart" | ... (future feeds)
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String    @default("running") // running | success | failed | skipped
  phase           String? // downloading | parsing | validating | saving | indexing | done
  progress        Int?      @default(0) // 0-100
  processedRows   Int?
  totalRows       Int?
  bytesDownloaded Int?
  rowsParsed      Int       @default(0)
  rowsValid       Int       @default(0)
  rowsInvalid     Int       @default(0)
  rowsUpserted    Int       @default(0)
  rowsStaleMarked Int       @default(0)
  rowsIndexed     Int       @default(0)
  rowsIndexFailed Int       @default(0)
  durationMs      Int?
  error           String?

  @@index([source, startedAt(sort: Desc)])
  @@index([status])
  @@map("sync_runs")
}

