}

model VehicleType {
  id        String    @id @default(uuid())
  slug      String    @unique
  title     String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  Vehicle[]

  @@map("vehicle_types")
}

model BodyType {
  id           String        @id @default(uuid())
