// Auction calendar scraped from AutoBidMaster (data/v2/auction-calendar). One row
// per (location, startedAt) occurrence across the 4 statuses × 2 groups. Fully
// replaced on each refresh. `url` is the pre-built AutoBidMaster search link
// (sale-location-id-<slug>/sale-date-<YYYYMMDD>, date in Central time). Global.
model AuctionCalendarEntry {
  id                  String   @id @default(uuid())
  status              String // live | later | upcoming | ended
  auctionGroup        String // usa | canada
  locationSourceId    Int
  catalogSourceId     Int?
  locationName        String
  locationSlug        String
  countryCode         String?
  region              String?
  latitude            Decimal? @db.Decimal(10, 7)
  longitude           Decimal? @db.Decimal(10, 7)
  startedAt           DateTime // absolute instant (parsed from the -07:00 ISO)
  saleDate            Int // YYYYMMDD in America/Chicago (Houston Central)
  inventoryAuction    String?
  totalAvailableItems Int      @default(0)
  url                 String   @db.Text
  // Staff toggle — preserved across calendar refreshes (by location+startedAt).
  monitor             Boolean  @default(false)
  // Agente asignado para operar esta subasta. Se preserva igual que `monitor`
  // porque cada refresco del calendario borra y recrea todas las filas.
  scraperAgentId      String?
  scraperAgent        ScraperAgent? @relation(fields: [scraperAgentId], references: [id], onDelete: SetNull)
  // VM que se llevó esta subasta hoy. Lo estampa el poll de /scraper/poll y es
  // exclusivo: mientras esté puesto, ninguna otra VM la recibe. Se preserva en
  // el refresco igual que los dos campos de arriba.
  scraperWorkerId     String?
  scraperWorker       ScraperWorker? @relation(fields: [scraperWorkerId], references: [id], onDelete: SetNull)
  raw                 Json?
  fetchedAt           DateTime @default(now())

  @@unique([locationSourceId, startedAt])
  @@index([status])
  @@index([saleDate])
  @@index([auctionGroup])
  @@index([monitor])
  @@index([scraperAgentId])
  // El poll filtra por (día, VM) y busca candidatos por (día, sin VM).
  @@index([saleDate, scraperWorkerId])
  @@map("auction_calendar_entries")
}

// Singleton control row for the auction-calendar scraper (refresh cadence).
model AuctionCalendarConfig {
  id            String    @id @default("singleton")
  refreshHours  Int       @default(6)
  lastFetchedAt DateTime?
  lastError     String?
  lastCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("auction_calendar_config")
}

// Cuentas de agente que el equipo usa para operar en los portales de subasta.
// La contraseña se guarda legible a propósito: hay que poder leerla para iniciar
// sesión con esa cuenta. Solo accesible a roles admin.
model ScraperAgent {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  email     String? // se rellena después de registrar la cuenta
  auction   String  @default("copart") // copart | iaai | autobidmaster
  country   String  @default("US") // país de registro de la cuenta
  password  String
  active    Boolean @default(true)
  notes     String?

  calendarEntries AuctionCalendarEntry[]
  worker          ScraperWorker?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auction, email])
  @@index([auction])
  @@index([country])
  @@index([active])
  @@map("scraper_agents")
}

// Ajustes del reparto entre VMs. Fila unica: son politica global, no de una
// maquina concreta.
model ScraperConfig {
  id String @id @default("singleton")

  /// Cuanto dura una venta. De aqui salen dos cosas: hasta cuando tiene sentido
  /// entrar a una subasta ya empezada, y cuando se le libera el hueco a la VM
  /// que la tenia.
  saleDurationHours Int @default(6)

  /// Sin poll durante este rato, la VM se da por muerta y se sueltan sus
  /// subastas aun no empezadas.
  deadWorkerMinutes Int @default(15)

  /// Cupo por defecto al darse de alta una VM nueva.
  defaultMaxAuctions Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("scraper_config")
}

// Una VM con Chrome + Automa. La fila se crea sola en el primer poll: dar de
// alta una máquina es arrancar el workflow con un `worker` nuevo, nada más.
//
// El cupo diario (`maxAuctions`) son pestañas abiertas a la vez, no un ritmo:
// la VM se lleva esas subastas para todo el día.
model ScraperWorker {
  id    String  @id // slug fijo en el workflow de Automa, p.ej. "vm-01"
  label String?

  // La cuenta que se le entrega en la respuesta del poll. @unique porque la
  // misma cuenta entrando desde dos IPs a la vez es justo lo que dispara los
  // bloqueos del portal.
  scraperAgentId String?       @unique
  scraperAgent   ScraperAgent? @relation(fields: [scraperAgentId], references: [id], onDelete: SetNull)

  enabled     Boolean @default(true)
  maxAuctions Int     @default(5)

  // El propio poll hace de heartbeat: no hay un endpoint aparte que la VM tenga
  // que acordarse de llamar.
  lastSeenAt  DateTime?
  lastClaimAt DateTime?
  lastIp      String?
  notes       String?

  entries AuctionCalendarEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@map("scraper_workers")
}

// Singleton control row for the headless live-sale monitor (auction-monitor app).
// Replaces the manual Chrome extension: a Puppeteer browser opens each monitored
// calendar entry's sale page a few minutes before it starts and forwards the
// Socket.IO "sold" frames straight into auction_sale_results.
model AuctionMonitorConfig {
  id     String  @id @default("singleton")
  paused Boolean @default(true) // master switch — starts OFF

  // Scheduling
  leadMinutes           Int @default(5) // open the page this many minutes before startedAt
  maxConcurrentSessions Int @default(6)
  idleStopMinutes       Int @default(25) // stop after this long with no frames
  maxDurationMinutes    Int @default(300) // hard cap per session

  // Frame filtering — mirrors the Chrome extension's options
  onlySold     Boolean @default(true)
  eventNames   String  @default("event") // comma-separated; empty = all
  wsUrlPattern String  @default("broadcast\\.autobidmaster\\.com")
  includeRaw   Boolean @default(false)

  // Optional mirror to the legacy n8n webhook while migrating off the extension
  forwardWebhookUrl String?

  // Login state (ABM_USER / ABM_PASS)
  loginOk     Boolean   @default(false)
  lastLoginAt DateTime?
  loginError  String?
  // The API container has no direct channel to the browser worker, so the DB is
  // the bus: the UI stamps this and the worker runs a login check on its next tick.
  loginTestRequestedAt DateTime?
  // Screenshot of the last login check — the only way to see a captcha or a
  // changed form from a headless container.
  loginScreenshotUrl   String?

  // Worker liveness, so the UI can tell "paused" from "the container is down".
  workerHeartbeatAt DateTime?

  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("auction_monitor_config")
}

// One browser session per monitored auction (calendar entry). Holds live counters
// so the UI can show what each page is capturing without touching the browser.
model AuctionMonitorSession {
  id              String  @id @default(uuid())
  calendarEntryId String? // soft link — calendar refreshes replace entries
  locationSourceId Int?
  locationName    String
  locationSlug    String
  saleDate        Int
  scheduledAt     DateTime // the entry's startedAt
  url             String   @db.Text

  // pending | starting | running | stopping | stopped | failed
  // "stopping" is how the UI asks the worker to close a page (DB as control bus).
  status String @default("pending")

  startedAt   DateTime?
  endedAt     DateTime?
  lastEventAt DateTime?

  framesSeen Int @default(0) // frames that passed the filters
  eventsSold Int @default(0)
  ingested   Int @default(0) // rows successfully written to auction_sale_results
  errors     Int @default(0)

  stopReason String? // idle | duration | manual | unmonitored | shutdown | error
  error      String?
  log        Json? // tail of recent log lines for the UI

  // [{ label, url, at }] — capped tail of page captures (S3/CDN urls).
  screenshots          Json?
  // Stamped by the UI to ask the worker for a fresh capture of the live page.
  screenshotRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([saleDate])
  @@index([scheduledAt])
  @@index([calendarEntryId])
  @@map("auction_monitor_sessions")
}

// One row per Copart lot whose gallery still needs to be cached to S3.
// Fed by the new-lot enqueuer (data-sync) and the backfill seeder; drained by
// the pausable image-cache crawler. The image-service consumer finalizes each
// row's status (done/failed) after uploading to S3. Global (auction data is shared).
model ImageCacheJob {
  lotNumber       BigInt    @id
  status          String    @default("pending") // pending | processing | done | failed
  priority        Int? // = AuctionListing.saleDate (YYYYMMDD); soonest auction first
  attempts        Int       @default(0)
  failedSequences Json? // sequences that never cached after maxAttempts
  lastError       String?
  lastAttemptAt   DateTime?
  source          String    @default("backfill") // new_lot | backfill | manual
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, priority])
  @@map("image_cache_jobs")
}

// Singleton control row for the image scraping/caching subsystem, edited from
// Settings → Image Cache. The crawler reads it every tick.
model ImageScrapeConfig {
  id                 String   @id @default("singleton")
  paused             Boolean  @default(false)
  lotsPerTick        Int      @default(6) // lots dispatched per crawler tick (~1/min cron)
  maxAttempts        Int      @default(5) // proxy retries per image before giving up
  perSequenceDelayMs Int      @default(0) // optional pause between sequences in the consumer
  concurrency        Int      @default(4) // bounded parallel image up/downloads per lot
  concurrentLots     Int      @default(1) // lots processed at once by the consumer (RabbitMQ prefetch)
  proxyResyncHours   Int      @default(168) // auto re-sync Webshare proxies every N hours (0 = off)
  proxyLastSyncAt    DateTime? // last time the proxy inventory was synced from Webshare

  // --- Retention: delete cached galleries N days after the auction ---
  // 0 = keep forever (the historical behaviour). Lots anyone showed interest in
  // (favourite, bid, group, review, AI analysis) are never deleted.
  retentionDays        Int       @default(0)
  retentionLastRunAt   DateTime?
  retentionDeletedLots Int       @default(0) // cumulative, for the UI
  retentionLastError   String?

  // Último cálculo del tamaño de gallery/ (2M+ objetos: el listado tarda minutos).
  // Se persiste para que el tile no muestre "…" tras cada reinicio del contenedor.
  storageBytes      BigInt?
  storageObjects    Int?
  storageComputedAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("image_scrape_config")
}

