/// Capital invested into the business and its funding sources (credit cards,
/// credit lines, loans, friends/investors). Tracks payback terms per source.
model Investment {
  id              String    @id @default(uuid())
  tenantId        String
  amount          Decimal   @db.Decimal(14, 2)
  // Funding source. Stored as a stable string enum validated at the DTO layer:
  // CREDIT_CARD | CREDIT_LINE | CAPITAL_FRIEND | LOAN | INVESTOR_GUEST
  source          String
  // The specific account / person the money came from (e.g. "Chase Visa 1234",
  // "Amigo Juan"). "Account off source".
  sourceAccount   String?
  // Amount to pay back (may exceed amount when there's interest).
  payBackAmount   Decimal?  @db.Decimal(14, 2)
  // Payback cadence: WEEKLY | BIWEEKLY | MONTHLY | QUARTERLY | ANNUAL | ONE_TIME | ...
  payBackInterval String?
  // Deadline to fully settle / liquidate.
  settleDeadline  DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, source])
  @@map("investments")
}

// ─── Social Media ─────────────────────────────────────────

model SocialAccount {
  id                  String    @id @default(uuid())
  tenantId            String
  platform            String // facebook, instagram, tiktok, youtube, linkedin, pinterest, threads, bluesky, gbp
  platformAccountId   String // external account/page ID from the platform
  name                String // display name (page name, handle, etc.)
  username            String? // @handle if applicable
  avatarUrl           String? // profile picture URL
  accessToken         String? // OAuth access token (encrypted at app level)
  refreshToken        String? // OAuth refresh token (encrypted at app level)
  tokenExpiresAt      DateTime? // when the access token expires
  scopes              String[]  @default([]) // granted OAuth scopes
  pageId              String? // for Facebook Pages (page ID vs user ID)
  isActive            Boolean   @default(true)
  lastSyncAt          DateTime?
  lastErrorAt         DateTime?
  lastErrorMsg        String?
  metaValue           Json? // platform-specific extra data
  accountType         String? // page | group | business | creator | personal | profile | organization | channel | location | phone_number
  publishMethod       String    @default("api") // api | reminder | none
  status              String    @default("active") // active | expired | error | disconnected
  profileUrl          String?
  encryptedSecrets    String? // AES-256-GCM blob (v1:<iv>:<tag>:<ct>); supersedes accessToken/refreshToken going forward
  webhookSubscribedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups             SocialGroupAccount[]
  postingSchedule    SocialPostingSchedule?
  goal               SocialGoal?
  postTargets        SocialPostTarget[]
  comments           SocialComment[]
  metricsDaily       SocialAccountMetricDaily[]
  inboxConversations InboxConversation[]

  @@unique([tenantId, platform, platformAccountId])
  @@index([tenantId])
  @@index([tenantId, platform])
  @@map("social_accounts")
}

/// Destino de chat al que un tenant reenvia sus notificaciones.
///
/// Las notificaciones solo viven dentro del dashboard: si nadie tiene la pestaña
/// abierta, un deposito o un fallo de sincronizacion no lo ve nadie. Esta tabla
/// guarda a donde sacarlas — Telegram, Discord o Slack.
model NotificationChannel {
  id       String @id @default(uuid())
  tenantId String
  provider String // telegram | discord | slack
  label    String // como lo llama el tenant: "Ventas", "Alertas tecnicas"

  /// A donde se entrega: chat_id de Telegram, URL del webhook de Discord o
  /// canal de Slack. Nunca se devuelve entero por la API.
  target String

  /// Secretos del proveedor (token de bot de Slack). Fuera de las respuestas.
  credentials Json?

  /// Tipos de notificacion que quiere este canal. Vacio = todos. Es columna y
  /// no un campo dentro de un Json porque el reparto filtra por ella.
  types String[] @default([])

  isActive Boolean @default(true)

  /// Emparejamiento de Telegram: el tenant manda este codigo al bot y el
  /// webhook lo canjea por el chat_id. De un solo uso y con caducidad.
  linkCode          String?   @unique
  linkCodeExpiresAt DateTime?

  /// Ultimo resultado del envio, para que la UI diga si el canal esta sano.
  lastSentAt   DateTime?
  lastErrorAt  DateTime?
  lastErrorMsg String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("notification_channels")
}

/// Conversacion del chat de IA sobre los datos de subasta.
model AiChatConversation {
  id       String @id @default(uuid())
  tenantId String
  userId   String
  /// Se genera con la primera pregunta para poder reconocerla en la lista.
  title    String

  messages  AiChatMessage[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // La lista del usuario se ordena por actividad reciente.
  @@index([userId, updatedAt])
  @@index([tenantId])
  @@map("ai_chat_conversations")
}

/// Un turno de la conversacion.
model AiChatMessage {
  id             String @id @default(uuid())
  conversationId String
  /// user | assistant
  role           String
  content        String @db.Text

  /// Que herramientas se llamaron y con que argumentos. Es lo que permite
  /// auditar de donde salio una cifra cuando alguien discute una respuesta.
  toolCalls Json?

  /// Consumo real, por mensaje. Sin esto el coste de la funcion es una
  /// adivinanza hasta que llega la factura.
  tokensIn  Int?
  tokensOut Int?
  model     String?
  latencyMs Int?

  createdAt DateTime @default(now())

  conversation AiChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_chat_messages")
}

model SocialGroup {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts SocialGroupAccount[]

  @@index([tenantId])
  @@map("social_groups")
}

model SocialGroupAccount {
  id              String @id @default(uuid())
  socialGroupId   String
  socialAccountId String

  group   SocialGroup   @relation(fields: [socialGroupId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialGroupId, socialAccountId])
  @@map("social_group_accounts")
}

// ─────────────────────────────────────────────────────────────────────────
// Social Suite — Buffer clone (compose/schedule/publish/organize/insights)
// + unified inbox for every DM channel and every Twilio number.
// Wire contract: docs/social-suite/contract.ts
// ─────────────────────────────────────────────────────────────────────────

/// Cola de publicacion de un canal: dias/horas fijos + timezone. 1:1 con SocialAccount.
model SocialPostingSchedule {
  id        String   @id @default(uuid())
  tenantId  String
  accountId String   @unique
  timezone  String   @default("America/Chicago")
  paused    Boolean  @default(false)
  slots     Json     @default("[]") // ScheduleSlot[] — { day: 0..6, time: "HH:mm" }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("social_posting_schedules")
}

/// Meta semanal de publicaciones por canal. 1:1 con SocialAccount.
model SocialGoal {
  id           String   @id @default(uuid())
  tenantId     String
  accountId    String   @unique
  postsPerWeek Int      @default(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("social_goals")
}

/// Configuracion del tenant para el Social Suite. Fila unica (lazy: se crea al primer GET).
model SocialSettings {
  id               String   @id @default(uuid())
  tenantId         String   @unique
  approvalRequired Boolean  @default(false)
  defaultTimezone  String   @default("America/Chicago")
  shortenLinks     Boolean  @default(false)
  utmEnabled       Boolean  @default(false)
  utmSource        String?
  utmMedium        String   @default("social")
  utmCampaign      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("social_settings")
}

/// Archivo (imagen/video/gif/documento) de la libreria de medios del Social Suite.
/// `key` es la llave S3 en el bucket privado (prefijo social/<tenantId>/).
model SocialMedia {
  id           String   @id @default(uuid())
  tenantId     String
  key          String   @unique
  kind         String // image | video | gif | document
  mimeType     String
  fileName     String?
  sizeBytes    Int
  width        Int?
  height       Int?
  durationSec  Float?
  altText      String?
  thumbnailKey String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy TenantUser? @relation("SocialMediaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("social_media")
}

/// Publicacion compuesta por el usuario: texto + medios base que cada SocialPostTarget puede sobreescribir.
model SocialPost {
  id            String    @id @default(uuid())
  tenantId      String
  status        String    @default("draft") // draft | pending_approval | scheduled | publishing | published | partial | failed
  content       String    @db.Text
  mediaIds      String[]  @default([])
  scheduleMode  String    @default("draft") // draft | queue | next | now | custom
  aiGenerated   Boolean   @default(false)
  ideaId        String?
  createdById   String?
  approvedById  String?
  approvedAt    DateTime?
  rejectionNote String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  idea       SocialIdea?        @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  createdBy  TenantUser?        @relation("SocialPostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy TenantUser?        @relation("SocialPostApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  targets    SocialPostTarget[]
  tags       SocialTag[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("social_posts")
}

/// Un canal de destino de un SocialPost: su propio contenido/medios opcionales, estado de
/// publicacion y metricas. La unidad real que el publisher de data-sync reclama y publica.
model SocialPostTarget {
  id               String    @id @default(uuid())
  tenantId         String
  postId           String
  accountId        String
  status           String    @default("draft") // draft | pending_approval | scheduled | publishing | published | failed | reminder_due | cancelled
  content          String?   @db.Text
  mediaOverride    Json?
  options          Json      @default("{}")
  thread           Json      @default("[]")
  firstComment     String?
  scheduledAt      DateTime?
  slotted          Boolean   @default(false)
  publishedAt      DateTime?
  externalId       String?
  externalUrl      String?
  error            String?
  attempts         Int       @default(0)
  lockedAt         DateTime?
  nextAttemptAt    DateTime?
  metrics          Json?
  metricsUpdatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  post     SocialPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  account  SocialAccount   @relation(fields: [accountId], references: [id])
  comments SocialComment[]

  @@index([status, scheduledAt])
  @@index([tenantId, accountId, scheduledAt])
  @@map("social_post_targets")
}

/// Etiqueta de tenant para posts e ideas.
model SocialTag {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String   @default("#6366F1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posts  SocialPost[]
  ideas  SocialIdea[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("social_tags")
}

/// Plantilla de texto reutilizable. El GET del endpoint le suma ~12 built-ins en memoria.
model SocialTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  content   String   @db.Text
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("social_templates")
}

/// Grupo de hashtags reutilizable (texto libre separado por espacios, cada uno con #).
model SocialHashtagGroup {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  hashtags  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("social_hashtag_groups")
}

/// Columna del tablero de ideas (To Do / In Progress / Done, creadas en el primer GET).
model SocialIdeaGroup {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  position  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ideas  SocialIdea[]

  @@index([tenantId])
  @@map("social_idea_groups")
}

/// Idea de contenido en el tablero. `groupId` null = columna "Unassigned".
model SocialIdea {
  id          String   @id @default(uuid())
  tenantId    String
  groupId     String?
  title       String
  content     String   @db.Text
  mediaIds    String[] @default([])
  position    Float    @default(0)
  sourceUrl   String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group     SocialIdeaGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy TenantUser?      @relation("SocialIdeaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tags      SocialTag[]
  posts     SocialPost[]

  @@index([tenantId])
  @@index([tenantId, groupId])
  @@map("social_ideas")
}

/// Feed RSS/Atom que el tenant sigue para inspirarse al crear posts.
model SocialFeed {
  id            String    @id @default(uuid())
  tenantId      String
  url           String
  title         String?
  siteUrl       String?
  lastFetchedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  SocialFeedItem[]

  @@unique([tenantId, url])
  @@index([tenantId])
  @@map("social_feeds")
}

model SocialFeedItem {
  id          String    @id @default(uuid())
  tenantId    String
  feedId      String
  guid        String
  title       String
  link        String
  summary     String?   @db.Text
  imageUrl    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feed   SocialFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@unique([feedId, guid])
  @@index([tenantId])
  @@map("social_feed_items")
}

/// Comentario/mencion/review normalizado de cualquier plataforma social, ingerido por webhook o poll.
model SocialComment {
  id                String    @id @default(uuid())
  tenantId          String
  accountId         String
  platform          String
  kind              String // comment | mention | review
  status            String    @default("open") // open | done
  externalId        String
  parentId          String?
  externalParentId  String?
  externalPostId    String?
  postTargetId      String?
  postPreview       Json?
  authorName        String
  authorHandle      String?
  authorAvatarUrl   String?
  authorExternalId  String?
  body              String    @db.Text
  permalink         String?
  rating            Int?
  fromUs            Boolean   @default(false)
  isHidden          Boolean   @default(false)
  likedByUs         Boolean   @default(false)
  repliedAt         DateTime?
  platformCreatedAt DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account    SocialAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  parent     SocialComment?    @relation("SocialCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies    SocialComment[]   @relation("SocialCommentReplies")
  postTarget SocialPostTarget? @relation(fields: [postTargetId], references: [id], onDelete: SetNull)

  @@unique([accountId, externalId])
  @@index([tenantId, kind, status, platformCreatedAt])
  @@map("social_comments")
}

/// Metricas diarias por cuenta (followers/impressions/...), una fila por dia.
model SocialAccountMetricDaily {
  id           String   @id @default(uuid())
  tenantId     String
  accountId    String
  date         DateTime @db.Date
  followers    Int?
  impressions  Int?
  reach        Int?
  engagements  Int?
  profileViews Int?
  videoViews   Int?
  clicks       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@index([tenantId])
  @@map("social_account_metrics_daily")
}

/// Pagina "link in bio" publica del tenant.
model SocialStartPage {
  id            String   @id @default(uuid())
  tenantId      String
  slug          String   @unique
  title         String
  bio           String?
  avatarMediaId String?
  theme         Json     @default("{}")
  blocks        Json     @default("[]")
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stats  SocialStartPageStat[]

  @@index([tenantId])
  @@map("social_start_pages")
}

/// Agregado diario de vistas/clicks de una start page, por bloque (blockId "" = la pagina entera).
model SocialStartPageStat {
  id        String   @id @default(uuid())
  tenantId  String
  pageId    String
  date      DateTime @db.Date
  blockId   String   @default("")
  views     Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  page   SocialStartPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, date, blockId])
  @@index([tenantId])
  @@map("social_start_page_stats")
}

/// Bandeja unificada: una conversacion por (tenant, canal, remitente-nuestro, contacto).
/// Cubre SMS/MMS (Twilio), WhatsApp y los DMs de cada red social conectada.
model InboxConversation {
  id                  String    @id @default(uuid())
  tenantId            String
  channel             String // sms | whatsapp | messenger | instagram | x | bluesky | mastodon
  provider            String // twilio | meta | x | bluesky | mastodon
  senderKind          String // twilio_number | social_account
  senderKey           String // twilioPhoneNumberId o socialAccountId, denormalizado para la unique key
  socialAccountId     String?
  twilioPhoneNumberId String?
  contactExternalId   String
  contactName         String?
  contactHandle       String?
  contactPhone        String?
  contactAvatarUrl    String?
  buyerId             String?
  status              String    @default("open") // open | done
  assignedToId        String?
  unreadCount         Int       @default(0)
  lastMessageAt       DateTime?
  lastMessagePreview  String?
  lastDirection       String?
  lastInboundAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  socialAccount     SocialAccount?     @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  twilioPhoneNumber TwilioPhoneNumber? @relation(fields: [twilioPhoneNumberId], references: [id], onDelete: SetNull)
  buyer             Buyer?             @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  assignedTo        TenantUser?        @relation("InboxConversationAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages          InboxMessage[]

  @@unique([tenantId, channel, senderKey, contactExternalId])
  @@index([tenantId, status, lastMessageAt])
  @@index([assignedToId])
  @@index([buyerId])
  @@map("inbox_conversations")
}

/// Un mensaje dentro de una InboxConversation. Idempotente en (channel, externalId).
/// `smsMessageId` la enlaza 1:1 con la fila espejo en SmsMessage cuando channel = "sms".
model InboxMessage {
  id                String    @id @default(uuid())
  tenantId          String
  conversationId    String
  channel           String
  direction         String // inbound | outbound
  body              String?   @db.Text
  attachments       Json      @default("[]")
  status            String // queued | sent | delivered | read | failed | received
  error             String?
  sentById          String?
  externalId        String?
  smsMessageId      String?   @unique
  platformCreatedAt DateTime
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentBy       TenantUser?       @relation("InboxMessageSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  smsMessage   SmsMessage?       @relation(fields: [smsMessageId], references: [id], onDelete: SetNull)

  @@unique([channel, externalId])
  @@index([tenantId])
  @@index([conversationId])
  @@map("inbox_messages")
}

/// Customer order for parts (e-commerce)
model PartOrder {
  id          String @id @default(uuid())
  tenantId    String
  orderNumber String
  buyerId     String
  status      String @default("draft")
  // draft | pending_payment | paid | ready_to_ship | shipped | delivered | cancelled | refunded

  subtotal     Decimal @default(0) @db.Decimal(10, 2)
  taxRate      Decimal @default(0) @db.Decimal(6, 4)
  tax          Decimal @default(0) @db.Decimal(10, 2)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @default(0) @db.Decimal(10, 2)

  // Payment
  paymentMethod         String? // stripe | cash | manual | other
  paymentStatus         String    @default("unpaid") // unpaid | processing | paid | refunded | failed
  stripePaymentIntentId String?
  stripeChargeId        String?
  paidAt                DateTime?

  // Shipping
  shippingMethod String? // pickup | ship
  shipToName     String?
  shipToStreet1  String?
  shipToStreet2  String?
  shipToCity     String?
  shipToState    String?
  shipToZip      String?
  shipToCountry  String? @default("US")
  shipToPhone    String?
  shipToEmail    String?

  notes         String?
  customerNotes String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buyer     Buyer           @relation(fields: [buyerId], references: [id])
  items     PartOrderItem[]
  shipments PartShipment[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([buyerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("part_orders")
}

model PartOrderItem {
  id           String   @id @default(uuid())
  orderId      String
  partId       String
  quantity     Int      @default(1)
  unitPrice    Decimal  @db.Decimal(10, 2)
  totalPrice   Decimal  @db.Decimal(10, 2)
  // Snapshot fields at time of order
  nameSnapshot String
  skuSnapshot  String?
  createdAt    DateTime @default(now())

  order PartOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  part  Part      @relation(fields: [partId], references: [id])

  @@index([orderId])
  @@index([partId])
  @@map("part_order_items")
}

model PartShipment {
  id               String  @id @default(uuid())
  orderId          String
  parcelTemplateId String?
  carrier          String  @default("ups")
  serviceLevel     String? // e.g. ups_ground
  serviceLevelName String?

  // Parcel dimensions snapshot
  length       Decimal? @db.Decimal(8, 2)
  width        Decimal? @db.Decimal(8, 2)
  height       Decimal? @db.Decimal(8, 2)
  distanceUnit String?  @default("in")
  weight       Decimal? @db.Decimal(8, 2)
  massUnit     String?  @default("lb")

  // Shippo
  shippoShipmentId    String?
  shippoTransactionId String?
  shippoRateId        String?
  labelUrl            String?
  trackingNumber      String?
  trackingUrl         String?
  trackingStatus      String?
  cost                Decimal? @db.Decimal(10, 2)

  status String @default("pending")
  // pending | label_purchased | shipped | in_transit | delivered | returned | failure | cancelled

  purchasedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order          PartOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parcelTemplate ParcelTemplate? @relation(fields: [parcelTemplateId], references: [id])

  @@index([orderId])
  @@index([trackingNumber])
  @@index([shippoShipmentId])
  @@map("part_shipments")
}

model ParcelTemplate {
  id                  String   @id @default(uuid())
  tenantId            String
  name                String
  carrier             String? // ups | null (custom)
  shippoTemplateToken String? // if imported from a Shippo carrier template
  length              Decimal  @db.Decimal(8, 2)
  width               Decimal  @db.Decimal(8, 2)
  height              Decimal  @db.Decimal(8, 2)
  distanceUnit        String   @default("in") // in | cm
  defaultWeight       Decimal? @db.Decimal(8, 2)
  massUnit            String   @default("lb") // lb | kg
  isDefault           Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipments PartShipment[]

  @@index([tenantId])
  @@index([carrier])
  @@map("parcel_templates")
}

model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  name        String
  description String?
  prefix      String    @unique // first 12 chars, shown in UI (e.g. "hta_live_abc")
  hashedKey   String    @unique @map("hashed_key") // sha256 of the full token
  scopes      String[]  @default([]) // ["orders:read", "orders:write", ...]
  createdById String?   @map("created_by_id")
  lastUsedAt  DateTime? @map("last_used_at")
  lastUsedIp  String?   @map("last_used_ip")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([prefix])
  @@index([revokedAt])
  @@map("api_keys")
}

// ────────────────────────────────────────────────────────────────────
// Vehicle inspections (Copart yard checklist + on-site media + voice
// notes). One inspection has many checklist items; each item carries
// quality (1=red, 2=yellow, 3=green), free-text notes, a voice-note
// transcription, and any number of media rows (image / video / audio).
// Inspection-level videos hang off VehicleInspection.media directly.
// Carfax is intentionally NOT a field here — it lives in CarfaxReport
// (keyed by vin) so the registry survives independently of any
// individual inspection.
// ────────────────────────────────────────────────────────────────────

enum VehicleInspectionStatus {
  REQUESTED // client requested it; not yet assigned
  IN_PROGRESS // inspector working on it
  DONE // completed
  REJECTED // refused (won't be done)
  CANCELED // canceled by the client / system
}

enum ChecklistCategory {
  FRONT_END // 1. Front end
  SIDE_PANELS // 2. Side panels (L/R)
  REAR_END // 3. Rear
  WHEELS_SUSPENSION // 4. Wheels & suspension
  INTERIOR // 5. Interior
  ENGINE_BAY // 6. Engine bay
  UNDERBODY // 7. Underbody
  LIGHTING_ELECTRICAL // 8. Exterior lighting & electrical
  REPAIR_BODYWORK // 9. Repair / bodywork signs
  FLOOD_DAMAGE // 10. Flood damage signs
  // Beyond visible body inspection — sensory and mechanical checks.
  FLUIDS // 11. Oil / coolant / transmission / brake fluid
  SENSORY // 12. Smell, noises, vibrations
  START_BEHAVIOR // 13. Cold start, hot start, idle quality
  OTHER
}

model VehicleInspection {
  id       String  @id @default(uuid())
  tenantId String?

  // What is being inspected (the lot/VIN — vehicleId is set only once the
  // lot becomes a Vehicle in our CRM, often AFTER the inspection happens).
  vin        String
  lotNumber  String?
  // yardName / yardNumber stay as a denormalized cache (copied from the
  // listing at request time); yardId is the source of truth.
  yardName   String?
  yardNumber String?
  yardId     String?
  yard       Yard?   @relation(fields: [yardId], references: [id], onDelete: SetNull)
  vehicleId  String?
  buyerId    String?

  // Lifecycle
  status      VehicleInspectionStatus @default(REQUESTED)
  requestedAt DateTime                @default(now())
  // Deadline: by when the inspection must be completed (set by the client
  // when requesting). Null = no hard deadline.
  dueAt       DateTime?
  inspectedAt DateTime?
  completedAt DateTime?
  inspectorId String?

  // Request from the client (free text — "check the engine", "look at the roof"...)
  specificRequest String?

  // Results
  overallRating Int? // 1..5 — caller's convention
  marketPrice   Decimal? @db.Decimal(12, 2)
  notes         String?

  // Cancellation (customer-initiated)
  cancelledAt         DateTime?
  cancelReason        String?
  cancelledByCustomer Boolean   @default(false)

  // Audit
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant        Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?                  @relation("VehicleInspections", fields: [vehicleId], references: [id], onDelete: SetNull)
  buyer         Buyer?                    @relation("BuyerInspections", fields: [buyerId], references: [id], onDelete: SetNull)
  checklist     InspectionChecklistItem[]
  errorCodes    InspectionErrorCode[]
  // Replaces the single specificRequest text — each item has its own note +
  // optional photo. specificRequest column is kept for backward compatibility.
  requestItems  InspectionRequestItem[]
  media         Media[]                   @relation("InspectionMedia")
  // Clients (users) granted read access to this inspection. Independent of
  // inspectorId (who performs it) — sharedWith governs who can VIEW it.
  sharedWith    User[]                    @relation("InspectionSharedWith")
  shareLinks    InspectionShareLink[]
  ledgerEntries CustomerLedgerEntry[]
  portalOrders  PortalOrder[]

  @@index([tenantId])
  @@index([vehicleId])
  @@index([buyerId])
  @@index([vin])
  @@index([lotNumber])
  @@index([status])
  @@index([requestedAt])
  @@index([dueAt])
  @@index([yardId])
  @@map("vehicle_inspections")
}

/// Public read-only share link for an inspection. The URL embeds the
/// VIN + token; the backend resolves the token to its inspection and
/// verifies the VIN matches before serving anything.
model InspectionShareLink {
  id             String            @id @default(uuid())
  token          String            @unique
  inspectionId   String
  inspection     VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  /// null = never expires.
  expiresAt      DateTime?
  revoked        Boolean           @default(false)
  /// User id of whoever generated the link (audit trail).
  createdBy      String?
  createdAt      DateTime          @default(now())
  /// Updated every time someone hits the public endpoint with this token.
  lastAccessedAt DateTime?
  /// ShortUrl.code companion — populated at creation so the admin gets a
  /// short link to share without an extra round-trip. Null when the
  /// shortener failed at create time (the share link still works).
  shortUrlCode   String?

  @@index([inspectionId])
  @@index([revoked])
  @@map("inspection_share_links")
}

model InspectionChecklistItem {
  id           String @id @default(uuid())
  inspectionId String

  category               ChecklistCategory
  part                   String // free text: "Hood", "Radiator support", "A-Pillar L", ...
  // 1 = RED (problem), 2 = YELLOW (review), 3 = GREEN (ok). Null = not yet evaluated.
  quality                Int?
  notes                  String?
  // Transcription of the voice note (the audio itself is a Media row in
  // `media` below with mediaType = 'audio').
  voiceNoteTranscription String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  media      Media[]           @relation("ChecklistItemMedia")

  @@index([inspectionId])
  @@index([category])
  @@map("inspection_checklist_items")
}

// ── Client-requested inspection items ─────────────────────────────
// One inspection has N request items, each a note + optional photo. Replaces
// the single specificRequest text field on VehicleInspection going forward
// (the column is kept for backward compatibility).
model InspectionRequestItem {
  id           String   @id @default(uuid())
  inspectionId String
  note         String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  media      Media[]           @relation("RequestItemMedia")

  @@index([inspectionId])
  @@map("inspection_request_items")
}

enum InspectionErrorLevel {
  GREEN
  YELLOW
  RED
}

/// Diagnostic trouble / error codes found during an inspection (e.g. OBD-II
/// codes), each with a severity level, note, optional voice-note transcription
/// and attached photos/videos. Shown in the dashboard (editable) and the web +
/// share-link views (read-only).
model InspectionErrorCode {
  id           String @id @default(uuid())
  inspectionId String

  code                   String
  description            String?
  level                  InspectionErrorLevel @default(GREEN)
  note                   String?
  voiceNoteTranscription String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  media      Media[]           @relation("ErrorCodeMedia")

  @@index([inspectionId])
  @@map("inspection_error_codes")
}

// ─── Contact Messages ─────────────────────────────────────────────────────────
// Web contact form submissions. tenantId is required (the form is always
// tenant-scoped). buyerId is optional — set only when a logged-in portal
// customer submits the form; otherwise the contact is anonymous.
// status lifecycle: NEW → READ → ARCHIVED (managed at the service layer).
// ─────────────────────────────────────────────────────────────────────────────

model ContactMessage {
  id       String  @id @default(uuid())
  tenantId String
  buyerId  String?
  name     String
  email    String
  phone    String?
  subject  String?
  message  String
  status   String  @default("NEW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buyer  Buyer? @relation(fields: [buyerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

// ─── Customer Portal ──────────────────────────────────────────────────────────
// Foundation for htownautos.com customer-facing portal:
//   - CustomerLedgerEntry: deposit/charge/refund ledger per buyer
//   - PortalOrder: Stripe-backed purchase orders for inspections/services
// ─────────────────────────────────────────────────────────────────────────────

enum CustomerLedgerEntryType {
  DEPOSIT // Customer adds funds (Stripe or manual)
  CHARGE // Funds charged for a service
  REFUND // Funds returned to the customer
  APPLIED // Funds applied toward a purchase order
  ADJUSTMENT // Manual correction by staff
}

enum CustomerLedgerEntryStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PortalOrderType {
  INSPECTION // Payment for a vehicle inspection
  SERVICE // Payment for another service
  DEPOSIT // Direct deposit to ledger balance
}

enum PortalOrderStatus {
  PENDING // Created, awaiting payment
  PAID // Payment confirmed
  FULFILLED // Service delivered / inspection completed
  CANCELED // Canceled before fulfillment
  REFUNDED // Payment reversed
}

/// Double-entry ledger for customer deposits, charges, refunds, and balance
/// adjustments. Balance is always derived (SUM) — never cached on Buyer.
model CustomerLedgerEntry {
  id       String  @id @default(uuid())
  tenantId String?
  buyerId  String

  type   CustomerLedgerEntryType
  status CustomerLedgerEntryStatus @default(PENDING)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("usd")

  description String?
  source      String? // e.g. "stripe", "manual"

  stripePaymentIntentId String? @map("stripe_payment_intent_id")

  // Optional link to the inspection this entry relates to.
  // SetNull so ledger history survives if the inspection is deleted.
  relatedInspectionId String?
  // Optional link to the deal this entry relates to.
  // SetNull so ledger history survives if the deal is deleted.
  relatedDealId       String?

  // Staff user who created this entry. Null = system or customer-initiated action.
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buyer             Buyer              @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  relatedInspection VehicleInspection? @relation(fields: [relatedInspectionId], references: [id], onDelete: SetNull)
  relatedDeal       Deal?              @relation(fields: [relatedDealId], references: [id], onDelete: SetNull)
  createdBy         User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, buyerId])
  @@index([stripePaymentIntentId])
  @@index([tenantId])
  @@index([buyerId])
  @@index([relatedInspectionId])
  @@index([relatedDealId])
  @@index([createdById])
  @@map("customer_ledger_entries")
}

/// Stripe-backed purchase order initiated from the customer portal.
/// Covers inspection payments, service payments, and direct deposits.
model PortalOrder {
  id       String  @id @default(uuid())
  tenantId String?
  buyerId  String

  type   PortalOrderType
  status PortalOrderStatus @default(PENDING)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("usd")

  description String?

  stripeCheckoutSessionId String? @map("stripe_checkout_session_id")
  stripePaymentIntentId   String? @map("stripe_payment_intent_id")

  // Set when an INSPECTION order is fulfilled — links the order to its
  // inspection. SetNull so the order survives if the inspection is deleted.
  relatedInspectionId String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buyer             Buyer              @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  relatedInspection VehicleInspection? @relation(fields: [relatedInspectionId], references: [id], onDelete: SetNull)

  @@index([tenantId, buyerId])
  @@index([status])
  @@index([stripeCheckoutSessionId])
  @@index([tenantId])
  @@index([buyerId])
  @@index([relatedInspectionId])
  @@index([stripePaymentIntentId])
  @@map("portal_orders")
}

// ─── Deposit Release ───────────────────────────────────────────────────────────
// Customer-initiated request to release account deposit balance back to their
// card. A staff admin approves or rejects in the dashboard. Approved requests
// trigger a Stripe refund; the refund ID is stored for reconciliation.
// ─────────────────────────────────────────────────────────────────────────────

enum DepositReleaseStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Customer-initiated request to release (refund) their account deposit balance.
/// Staff approves or rejects; approval triggers a Stripe refund captured in stripeRefundId.
model DepositReleaseRequest {
  id       String  @id @default(uuid())
  tenantId String?
  buyerId  String

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("usd")

  status DepositReleaseStatus @default(PENDING)

  note         String? // optional customer note submitted with request
  decisionNote String? // optional admin note on approve/reject

  stripeRefundId String? @map("stripe_refund_id") // set when approved + refunded via Stripe

  decidedById String? // staff User who approved or rejected
  decidedAt   DateTime? // timestamp of the approve/reject action

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  buyer     Buyer   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("DepositReleaseDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([tenantId, buyerId])
  @@index([buyerId])
  @@index([status])
  @@index([tenantId])
  @@index([decidedById])
  @@map("deposit_release_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// Vectores de imagen y el job nocturno que los produce
// ─────────────────────────────────────────────────────────────────────────────

/// Las fotos de un lote, ya convertidas a numeros por DINOv2 + PCA.
///
/// Append-only a proposito: las fotos de un lote NO cambian nunca, asi que una
/// vez calculado el vector ese lote esta resuelto para siempre. El job nocturno
/// solo anade; nunca reprocesa. Por eso la pasada inicial costo ~$5 y las
/// diarias cuestan centimos.
///
/// `pcaVersion` existe para un fallo que no da error: si alguien reajusta el PCA,
/// los vectores nuevos dejan de significar lo mismo que los que entrenaron el
/// modelo. Guardando la version se detecta la mezcla en vez de servir numeros
/// silenciosamente corruptos.
model LotImageVector {
  lotNumber  BigInt   @id
  /// float32 empaquetados (64 dims = 256 bytes). Bytes y no Float[] porque
  /// Postgres guarda cada elemento de un array float8 con cabecera propia.
  vector     Bytes
  dims       Int
  /// p.ej. "dinov2-giant@518"
  encoder    String
  pcaVersion String
  imageCount Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([encoder, pcaVersion])
  @@map("lot_image_vectors")
}

/// Una ejecucion del job nocturno. Es tambien el registro contable: cuanto duro,
/// que pod se alquilo, cuanto costo y —lo mas importante— quien apago el pod.
model EmbedJobRun {
  id     String @id @default(uuid())
  /// pending | provisioning | running | done | failed | aborted
  status String @default("pending")

  podId      String?
  podType    String?
  /// Precio/hora que reporto RunPod al crear el pod.
  costPerHr  Decimal? @db.Decimal(8, 4)
  /// Coste estimado = costPerHr * horas facturadas.
  costUsd    Decimal? @db.Decimal(8, 4)
  gpuSeconds Int?

  startedAt    DateTime  @default(now())
  podReadyAt   DateTime?
  finishedAt   DateTime?
  terminatedAt DateTime?
  /// Ultima vez que el POD hablo (log o vectores). Es lo unico que distingue un
  /// pod huerfano de uno trabajando cuando el backend se reinicia: el pod es
  /// independiente y sigue a lo suyo mientras el contenedor se redespliega.
  lastSeenAt   DateTime?
  /// Cual de las vias apago el pod: job | deadline | watchdog | boot | self | manual.
  /// Si aparece algo distinto de `job` de forma habitual, hay una via fallando.
  terminatedBy String?

  /// El ciclo de rebuild que la pidio, si no fue una ejecucion suelta. Cuando
  /// viene de un ciclo, los lotes NO salen de los filtros de la config sino de
  /// la ventana del ciclo.
  rebuildId String?

  /// Esta ejecucion ignora los filtros de la config y coge todo lo pendiente.
  /// Es la valvula de escape para vaciar la cola sin tocar los ajustes.
  selectionAll Boolean @default(false)

  lotsRequested Int @default(0)
  lotsDone      Int @default(0)
  imagesDone    Int @default(0)
  imagesFailed  Int @default(0)

  error String? @db.Text
  log   String? @db.Text

  @@index([startedAt])
  @@index([status])
  @@map("embed_job_runs")
}

/// Ajustes del job nocturno, editables desde Auction Data.
model EmbedJobConfig {
  id      String  @id @default("singleton")
  enabled Boolean @default(false)

  /// Hora local (Central) a la que arranca. Los lotes se cachean con dias de
  /// antelacion, asi que de madrugada llega de sobra.
  cronHour       Int @default(3)
  /// Cada cuantas horas se repite. 24 o mas = una vez al dia a `cronHour`, el
  /// comportamiento de siempre. Menos = cada N horas, sin mirar la hora: los
  /// remates son a todas horas y un lote que se subasta a las 14:00 no lo
  /// salva un trabajo que solo pasa de madrugada.
  cronEveryHours Int @default(24)

  /// GPUs a intentar, en orden. RunPod alquila la primera disponible.
  gpuTypeIds String @default("NVIDIA A40,NVIDIA RTX A5000,NVIDIA A100 80GB PCIe")
  imageName  String @default("")

  /// Corta-circuitos. Ninguno es opcional: son lo que impide que un fallo se
  /// convierta en un pod encendido 24 horas.
  maxLotsPerRun    Int     @default(20000)
  maxMinutes       Int     @default(180)
  maxCostUsdPerRun Decimal @default(5.0) @db.Decimal(8, 2)
  /// Precio/hora maximo aceptable al alquilar.
  ///
  /// La API de RunPod no deja PEDIR un pod barato: no hay ningun parametro de
  /// precio en `POST /pods`, y `gpuTypePriority: availability` optimiza por
  /// conseguir GPU, no por coste. El mismo A40 se ha alquilado a $0,27, a $0,49
  /// y una vez a $1,59 segun el host que toque. Lo unico que se puede hacer es
  /// mirar el precio nada mas crearlo y devolverlo si se pasa, que cuesta
  /// segundos de facturacion.
  maxCostPerHr     Decimal @default(0.60) @db.Decimal(8, 4)

  // ── Que lotes entran en la cola ──
  // Sin esto la cola era "todo lo pendiente, del mas viejo al mas nuevo", que
  // gasta GPU en coches ya subastados mientras los que se van a pujar esperan
  // detras de 218.066 filas. Estos campos deciden QUE entra; el orden (proxima
  // subasta primero) va fijo en la consulta.
  /// Lotes con fecha de venta asignada y todavia por subastar.
  selDated        Boolean @default(true)
  /// Lotes que Copart aun no ha fechado ("Future Sale"): venderan mas adelante.
  selFutureSale   Boolean @default(true)
  /// Lotes ya subastados. No sirven para pujar, si para entrenar: por eso
  /// existen como opcion, y por eso empiezan apagados.
  selIncludePast  Boolean @default(false)
  /// Acota `selDated` a un rango de fechas de venta (YYYYMMDD, inclusive).
  selSaleDateFrom Int?
  selSaleDateTo   Int?
  /// Solo lotes con precio de martillo registrado.
  ///
  /// Para el corpus de entrenamiento, un lote sin precio no sirve: falta la
  /// etiqueta. De los 218.066 ya subastados con fotos, solo 95.572 tienen venta
  /// registrada — sin este filtro se paga GPU por 122.494 que no entrenan nada.
  selSoldOnly     Boolean @default(false)

  /// Cada cuanto el vigilante busca pods huerfanos (minutos).
  watchdogMinutes Int @default(5)

  // ── Como se agrupan las fotos de un lote en un solo vector ──
  /// `mean` promedia todas las fotos; `slots` da columnas propias a las
  /// primeras `imgSlots` secuencias y promedia el resto.
  ///
  /// Cambiarlo invalida TODOS los vectores ya calculados: siguen teniendo 64
  /// dimensiones pero significan otra cosa, y mezclarlos con los nuevos no
  /// lanza ningun error — solo predicciones peores. Por eso cada vector lleva
  /// su `pcaVersion` y el ciclo trata como pendiente lo que no coincide.
  pooling  String @default("mean")
  imgSlots Int    @default(4)

  // ── Rebuild automatico ──
  /// Rehace el ciclo entero (embeber lo que falte + reentrenar) cada N dias.
  /// Arranca apagado: alquila GPUs, asi que encenderlo es una decision.
  autoRebuildEnabled   Boolean   @default(false)
  autoRebuildEveryDays Int       @default(30)
  autoRebuildHour      Int       @default(3)
  lastAutoRebuildAt    DateTime?
  /// Tope de gasto para UN ciclo completo, sumando todas sus tandas de pod.
  /// `maxCostUsdPerRun` acota una tanda; sin este, un ciclo con veinte tandas
  /// no tiene techo.
  maxCostUsdPerRebuild Decimal   @default(20.0) @db.Decimal(8, 2)

  // ── Reentrenamiento del modelo de precio ──
  /// Ventana movil: solo se entrena con ventas de los ultimos N dias. Precios de
  /// hace medio año no describen el mercado de esta semana. 0 = todo el
  /// historico, que es lo que se pide al reconstruir desde cero.
  trainingDays           Int       @default(90)
  /// Si false, el modelo nuevo se entrena y se mide pero NO sustituye al que
  /// esta sirviendo aunque gane. Util para observar unas semanas antes de soltar
  /// el automatismo.
  autoPromote            Boolean   @default(true)
  /// Entrenar SOLO con ventas cuyo lote tiene vector de imagen: el modelo visor.
  ///
  /// Ninguna fila entra a ciegas, pero el corpus se encoge a lo que el job de
  /// vectores haya procesado. Encenderlo antes de haber embebido los vendidos
  /// deja el entrenamiento en unos miles de filas en vez de cientos de miles.
  trainingOnlyWithImages Boolean   @default(false)
  lastTrainingAt         DateTime?

  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("embed_job_config")
}

/// Una ejecucion del reentrenamiento del modelo de precio.
///
/// Guarda las metricas de los DOS modelos —el que estaba en produccion y el
/// recien entrenado— porque la decision de promover se toma comparandolos, y sin
/// las dos cifras no hay forma de auditar por que se promovio o por que no.
/// Una consulta de SPV ya resuelta.
///
/// Guardarlas no es solo cache: TxDMV no tiene API y su calculadora es un
/// formulario publico, asi que cada consulta ahorrada es una peticion que no se
/// le hace a un servicio del estado. Los valores se recalculan una vez por
/// semana, asi que una fila de hace tres dias vale exactamente lo mismo que
/// preguntar de nuevo.
///
/// Ojo: esto es la foto de HOY. El impuesto de un tramite se calcula con el SPV
/// del dia de la operacion, asi que quien cierre un trato debe copiarse el valor
/// en su propio registro en vez de volver a leer esta tabla mas adelante.
model SpvQuote {
  id String @id @default(uuid())

  /// Por ahora siempre TX. Existe para que anadir otro estado no sea migrar.
  state    String
  vin      String
  /// El odometro forma parte de la clave: el valor depende de el.
  odometer Int

  year  Int?
  make  String?
  model String?
  /// Valor en dolares enteros, como lo publica TxDMV.
  value Int

  /// De donde salio el numero: txdmv.
  source    String   @default("txdmv")
  fetchedAt DateTime @default(now())

  @@unique([state, vin, odometer])
  @@index([fetchedAt])
  @@map("spv_quotes")
}

/// Un ciclo completo: embeber las fotos que faltan y, cuando estan, reentrenar.
///
/// Existe como tabla propia porque son dos procesos de naturaleza distinta —uno
/// alquila GPUs durante horas y el otro son minutos de CPU— y hasta ahora habia
/// que encadenarlos a mano: lanzar vectores, volver al dia siguiente, mirar si
/// termino y entonces entrenar. El estado vive en la base y no en memoria para
/// que un redespliegue a mitad de ciclo no lo pierda.
model ModelRebuildRun {
  id String @id @default(uuid())

  /// queued | embedding | training | done | failed | cancelled
  status  String @default("queued")
  /// manual | scheduled
  trigger String @default("manual")

  /// Ventana de dias de venta que entra en el ciclo. 0 = todo el historico.
  windowDays Int
  /// Con que agrupacion se embebio: lo que no coincida se considera pendiente.
  pooling    String
  pcaVersion String?

  /// Lotes en la ventana a los que les faltaba el vector al empezar.
  lotsTarget Int     @default(0)
  /// Lotes ya embebidos por este ciclo.
  lotsDone   Int     @default(0)
  /// Cuantas tandas de pod han hecho falta.
  embedRuns  Int     @default(0)
  /// Lo que lleva gastado el ciclo entero, sumando sus tandas.
  costUsd    Decimal @default(0) @db.Decimal(8, 4)

  /// El entrenamiento que cerro el ciclo.
  trainingRunId String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?   @db.Text
  log        String?   @db.Text

  @@index([startedAt])
  @@index([status])
  @@map("model_rebuild_runs")
}

model ModelTrainingRun {
  id     String @id @default(uuid())
  /// pending | running | done | failed
  status String @default("pending")

  /// Ventana movil de dias de ventas usada para entrenar. Los precios viejos no
  /// interesan: el mercado de salvage se mueve con la chatarra y la temporada.
  /// 0 = todo el historico, para reconstruir el modelo desde cero.
  trainingDays Int @default(90)

  /// Si la ejecucion se limito a las ventas con vector de imagen.
  onlyWithImages Boolean @default(false)

  rowsTrain      Int?
  rowsValid      Int?
  /// Cuantas filas del entrenamiento traian vector de imagen.
  rowsWithImages Int?

  /// MAE del modelo que estaba sirviendo, sobre el mismo examen.
  maeChampion      Decimal? @db.Decimal(10, 2)
  /// MAE del recien entrenado.
  maeChallenger    Decimal? @db.Decimal(10, 2)
  /// MAE del baseline tonto (mediana por marca/modelo/año/titulo), como suelo.
  maeBaseline      Decimal? @db.Decimal(10, 2)
  intervalCoverage Decimal? @db.Decimal(5, 3)

  /// Si el nuevo sustituyo al anterior, y por que no si no lo hizo.
  promoted       Boolean @default(false)
  promotedReason String?
  modelVersion   String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?   @db.Text
  log        String?   @db.Text

  @@index([startedAt])
  @@map("model_training_runs")
}

/// Un tramite (130-U, VTR-66, …) generado para un vehiculo y enviado a DocuSeal.
///
/// Se guarda lo que rellenamos (`values`) ademas de los identificadores de
/// DocuSeal: si alguien discute que decia el formulario, la respuesta esta aqui
/// y no depende de que DocuSeal siga vivo. El PDF firmado se archiva como Media
/// del vehiculo, que es donde el usuario ya busca sus documentos.
model VehicleDocument {
  id            String    @id @default(uuid())
  tenantId      String?
  vehicleId     String
  /// Cliente del CRM cuyos datos se usaron, si se eligio uno.
  buyerId       String?
  /// Clave interna del formulario: form-130-u, vtr-66, vtr-271…
  formKey       String
  formName      String
  templateId    Int
  submissionId  Int
  submitterSlug String
  /// draft | sent | opened | completed | declined
  status        String    @default("draft")
  /// Lo enviado a DocuSeal, tal cual.
  values        Json
  /// PDF firmado, ya archivado entre los documentos del vehiculo.
  mediaId       String?
  sentTo        String?
  sentAt        DateTime?
  completedAt   DateTime?
  auditLogUrl   String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  buyer   Buyer?  @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([submissionId])
  @@index([vehicleId, createdAt])
  @@index([tenantId])
  @@map("vehicle_documents")
}

// ═══════════════════════════════════════════════════════════════════════════
//  Daños por pieza, vistos por un modelo de visión
//
//  ── Por que un catalogo y no 180 columnas ──
//  El objetivo es entrenar: hace falta un vector de features FIJO y ordenado,
//  con las piezas sanas como hueco. Eso se puede conseguir de dos maneras.
//
//  Guardando una fila por lote con 180 piezas x 4 campos = 720 columnas, o una
//  fila por (lote, pieza) para TODAS las piezas: 1,6M lotes x 180 = 288 millones
//  de filas, el 95% vacias. Las dos funcionan y las dos son un error: en la
//  primera, anadir una pieza es un ALTER sobre una tabla de millones de filas;
//  en la segunda se paga almacenamiento y escritura por informacion que es,
//  literalmente, la ausencia de informacion.
//
//  Aqui se guarda SOLO lo danado, y el vector completo se reconstruye con un
//  LEFT JOIN contra `damage_parts`. El catalogo es lo que garantiza que los
//  campos existen, y al ser datos y no DDL, anadir una pieza es un INSERT.
//
//  ── El NULL es ambiguo, y para entrenar eso importa ──
//  Que una pieza no venga puede significar cuatro cosas distintas: que esta
//  sana, que no salia en ninguna foto, que ese vehiculo no la tiene (la caja de
//  una camioneta en un sedan), o que el modelo se quedo sin espacio antes de
//  llegar a ella. Un modelo de precio que trate esos cuatro casos como el mismo
//  NULL aprende ruido. Por eso `LotDamageAnalysis` guarda que fotos se vieron y
//  que zonas quedaron cubiertas: con eso, "sana" y "no visible" se distinguen al
//  construir las features en vez de perderse.
// ═══════════════════════════════════════════════════════════════════════════

enum DamagePartGroup {
  exterior
  interior
}

enum VehicleSide {
  left
  right
}

/// Tipos de dano. Los siete primeros son los del catalogo original; los tres
/// ultimos se anadieron porque son los que mueven el precio en salvamento y no
/// tenian donde encajar: un airbag desplegado no es "broken", un coche quemado
/// no es "paint_damage", y una inundacion no se parece a nada de la lista.
enum VehicleDamageType {
  dent
  scratch
  crack
  missing
  broken
  paint_damage
  misalignment
  burn
  water_damage
  deployed
}

enum VehicleRepairAction {
  repair
  replace
  inspect
}

/// Catalogo de piezas: la fuente de verdad de que campos existen.
///
/// `orden` fija la posicion de cada pieza en el vector de entrenamiento y NO se
/// reordena nunca. Si cambiara, las features de hoy dejarian de significar lo
/// mismo que las que entrenaron el modelo, y este se degradaria sin lanzar un
/// solo error — el mismo problema que el PCA congelado de los vectores de imagen.
model DamagePart {
  code       String          @id
  grupo      DamagePartGroup
  /// "front_end", "side_body_left", "safety"...
  subgrupo   String
  lado       VehicleSide?
  /// Piezas que solo existen en camionetas (caja, porton, cubrecaja).
  soloPickup Boolean         @default(false)
  /// Posicion fija en el vector de features. Inmutable.
  orden      Int             @unique
  /// Se desactiva en vez de borrarse: los analisis viejos la siguen referenciando.
  activo     Boolean         @default(true)

  damages LotPartDamage[]

  @@index([grupo, subgrupo])
  @@map("damage_parts")
}

/// Una pasada de analisis sobre un lote. Guarda de donde salieron los datos.
model LotDamageAnalysis {
  id        String @id @default(uuid())
  lotNumber BigInt

  /// Sin esto no se pueden comparar dos epocas: un cambio de modelo o de prompt
  /// cambia la distribucion de las features, y el modelo de precio lo nota.
  modelo        String
  promptVersion String

  /// Cuantas fotos vio y cuales. Es lo que permite leer un hueco como "sana"
  /// en vez de como "no habia foto de esa zona".
  fotosVistas      Int      @default(0)
  secuenciasVistas Int[]    @default([])
  /// Subgrupos con cobertura fotografica confirmada.
  zonasCubiertas   String[] @default([])

  /// done | partial | failed. `partial` = se corto antes de terminar, y sus
  /// huecos NO significan "sana".
  status String  @default("done")
  error  String?

  tokensEntrada Int?
  tokensSalida  Int?
  costeUsd      Decimal? @db.Decimal(10, 6)
  duracionMs    Int?

  createdAt DateTime @default(now())

  listing AuctionListing  @relation(fields: [lotNumber], references: [lotNumber], onDelete: Cascade)
  damages LotPartDamage[]

  @@index([lotNumber, createdAt])
  @@index([modelo, createdAt])
  @@map("lot_damage_analyses")
}

/// Una pieza danada. Las sanas no se guardan: se reconstruyen con el catalogo.
model LotPartDamage {
  analysisId String
  partCode   String
  /// Denormalizado a proposito: construir el corpus de entrenamiento filtra por
  /// lote sobre decenas de millones de filas, y sin esto cada consulta pasa por
  /// la tabla de analisis.
  lotNumber  BigInt

  /// Una pieza puede tener varios a la vez: abollada Y rayada.
  damageTypes  VehicleDamageType[]  @default([])
  /// 0-10. Nullable a proposito: el modelo puede ver el dano sin saber graduarlo.
  severity     Int?
  repairAction VehicleRepairAction?
  /// 0-100, lo seguro que estaba el modelo. Permite entrenar solo con lo firme.
  confidence   Int?
  /// Lo que el modelo describio, para poder auditar a mano.
  nota         String?

  analysis LotDamageAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  part     DamagePart        @relation(fields: [partCode], references: [code])

  @@id([analysisId, partCode])
  @@index([lotNumber])
  @@index([partCode])
  @@map("lot_part_damages")
}

/// Configuracion de la prediccion masiva de lotes futuros.
///
/// Va en su propia tabla y no en `EmbedJobConfig` porque son dos trabajos
/// distintos: aquel llena el material de entrenamiento con ventas pasadas,
/// este tasa coches que todavia no se han subastado. Comparten la GPU y poco
/// mas, y mezclar sus ajustes obliga a leer el nombre del campo para saber a
/// cual pertenece.
model PricePredictConfig {
  id String @id @default("singleton")

  // ── Que lotes entran ──────────────────────────────────────────────────────
  /// Copart ya les puso fecha de subasta.
  selDated        Boolean @default(true)
  /// Aun sin fecha: se venderan, pero no se sabe cuando.
  selUndated      Boolean @default(false)
  selSaleDateFrom Int?
  selSaleDateTo   Int?
  /// Estados y marcas, separados por coma. Vacio = todos.
  selStates       String  @default("")
  selMakes        String  @default("")
  selMinRetail    Int?
  selMaxRetail    Int?

  // ── Que se vuelve a predecir ──────────────────────────────────────────────
  /// Saltarse los que ya tienen prediccion. Apagado = se recalculan todos.
  skipAlreadyPredicted Boolean @default(true)
  /// Aunque tengan prediccion, rehacerla si la hizo otra version del modelo:
  /// un precio de un modelo retirado no es comparable con uno de hoy.
  redoIfModelChanged   Boolean @default(true)
  /// Y rehacerla si es mas vieja que esto. 0 = no caduca.
  redoOlderThanDays    Int     @default(7)

  // ── Fotos ─────────────────────────────────────────────────────────────────
  /// conVector   solo lotes que ya tienen vector — no gasta GPU
  /// embeber     los que falten se mandan primero al pod
  /// sinFotos    se predice igual, sin fotos, peor y mas barato
  photoMode      String @default("embeber")
  /// Tope de lotes a embeber en una pasada, aparte del tope de prediccion.
  maxLotsToEmbed Int    @default(5000)

  // ── Limites de la pasada ──────────────────────────────────────────────────
  maxLotsPerRun    Int     @default(20000)
  /// Lotes por llamada a /predict/batch. Muy alto agota la memoria del
  /// servicio; muy bajo desperdicia el viaje.
  batchSize        Int     @default(500)
  maxMinutes       Int     @default(120)
  maxCostUsdPerRun Decimal @default(5.0) @db.Decimal(8, 2)

  // ── Cuando se ejecuta sola ────────────────────────────────────────────────
  enabled   Boolean   @default(false)
  cronHour  Int       @default(5)
  everyDays Int       @default(1)
  lastRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("price_predict_config")
}

/// Una pasada de prediccion masiva.
model PricePredictRun {
  id         String    @id @default(uuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// pending | embedding | predicting | done | failed | aborted
  status     String    @default("pending")
  /// manual | cron
  trigger    String    @default("manual")

  /// Cuantos cumplian el filtro y cuantos se llegaron a tasar.
  lotesElegibles Int @default(0)
  lotesPredichos Int @default(0)
  /// De los tasados, cuantos llevaban fotos: es lo que separa una prediccion
  /// buena de una a ciegas.
  lotesConFotos  Int @default(0)
  lotesEmbebidos Int @default(0)

  /// Version del modelo que firmo estas predicciones.
  modelVersion String?
  costUsd      Decimal @default(0) @db.Decimal(8, 4)
  error        String?
  /// Traza de la pasada, como en los demas trabajos.
  log          Json?

  @@index([startedAt])
  @@map("price_predict_runs")
}

/// La prediccion de un lote, con la version del modelo que la hizo.
///
/// Tabla aparte y no columnas en `AuctionListing` porque el mismo lote se
/// vuelve a tasar cuando cambia el modelo, y conviene poder comparar que decia
/// la version anterior antes de creerse la nueva.
model LotPricePrediction {
  lot           BigInt   @id
  esperado      Int
  p10           Int
  p90           Int
  /// (p90 - p10) / esperado. Cuanto mas alto, menos sabe el modelo.
  incertidumbre Decimal  @db.Decimal(6, 3)
  conImagenes   Boolean  @default(false)
  modelVersion  String
  runId         String?
  predictedAt   DateTime @default(now())

  @@index([predictedAt])
  @@index([modelVersion])
  @@map("lot_price_predictions")
}
