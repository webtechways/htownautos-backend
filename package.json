{
  "name": "htownautos-backend",
  "version": "0.0.1",
  "description": "HTown Autos Backend - NX Monorepo",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nx run-many --target=build",
    "build:api": "nx build api",
    "build:image-service": "nx build image-service",
    "build:ai-services": "nx build ai-services",
    "build:data-sync": "nx build data-sync",
    "start:api": "nx serve api",
    "start:image-service": "nx serve image-service",
    "start:ai-services": "nx serve ai-services",
    "start:data-sync": "nx serve data-sync",
    "predev": "node scripts/kill-ports.js; sleep 1",
    "dev": "nx run-many --target=serve --parallel=4",
    "dev:api": "nx serve api",
    "dev:image-service": "nx serve image-service",
    "dev:ai-services": "nx serve ai-services",
    "dev:data-sync": "nx serve data-sync",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "jest",
    "identity:backfill": "ts-node scripts/backfill-customer-identity.ts",
    "identity:reprocess": "ts-node scripts/reprocess-clerk-events.ts",
    "seed": "tsx libs/prisma/prisma/seeds/index.ts",
    "seed:prod": "node dist/apps/api/prisma/seeds/index.js",
    "db:migrate": "prisma migrate dev --schema=libs/prisma/prisma/schema.prisma",
    "db:push": "prisma db push --schema=libs/prisma/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=libs/prisma/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=libs/prisma/prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.967.0",
    "@aws-sdk/s3-request-presigner": "^3.967.0",
    "@clerk/backend": "^3.2.7",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/platform-socket.io": "^11.1.13",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.13",
    "@opensearch-project/opensearch": "^3.5.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.4.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/pg-copy-streams": "^1.2.5",
    "amqplib": "^0.10.9",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "crypto-js": "^4.2.0",
    "csv-parse": "^7.0.0",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "jwks-rsa": "^3.2.1",
    "multer": "^2.0.2",
    "nestjs-pino": "^4.6.0",
    "openai": "^6.22.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pg-copy-streams": "^7.0.0",
    "postmark": "^4.0.7",
    "prom-client": "^15.1.3",
    "puppeteer-core": "^25.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "shippo": "^2.18.0",
    "socket.io": "^4.8.3",
    "stripe": "^20.4.0",
    "twilio": "^5.12.1",
    "undici": "^7.22.0",
    "zipcodes": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@nx/js": "^21.6.10",
    "@nx/nest": "^21.6.10",
    "@nx/node": "^21.6.10",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "nodemon": "^3.1.14",
    "nx": "^21.6.10",
    "prettier": "^3.4.2",
    "prisma": "^7.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node",
            "resolvePackageJsonExports": false,
            "esModuleInterop": true,
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@htownautos/prisma$": "<rootDir>/libs/prisma/src/index.ts",
      "^@htownautos/common$": "<rootDir>/libs/common/src/index.ts",
      "^@htownautos/rabbitmq$": "<rootDir>/libs/rabbitmq/src/index.ts",
      "^@htownautos/redis$": "<rootDir>/libs/redis/src/index.ts",
      "^@htownautos/auth$": "<rootDir>/libs/auth/src/index.ts",
      "^@htownautos/media$": "<rootDir>/apps/image-service/src/media/index.ts",
      "^@htownautos/tts$": "<rootDir>/apps/ai-services/src/tts/index.ts",
      "^@htownautos/carfax-analyzer$": "<rootDir>/apps/ai-services/src/carfax-analyzer/index.ts",
      "^@htownautos/opensearch$": "<rootDir>/libs/opensearch/src/index.ts",
      "^@htownautos/auction-matching$": "<rootDir>/libs/auction-matching/src/index.ts",
      "^@htownautos/social$": "<rootDir>/libs/social/src/index.ts",
      "^@htownautos/damage-detector$": "<rootDir>/apps/ai-services/src/damage-detector/index.ts"
    }
  }
}
