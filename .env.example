# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3000

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_URL="postgresql://user:password@localhost:5432/htownautos?schema=public"

# ===========================================
# AWS S3 CONFIGURATION
# ===========================================
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# CDN base URL (optional) - if set, public media URLs use this instead of direct S3 URLs
# CDN_BASE_URL=https://cdn.htownautos.com

# ===========================================
# SECURITY CONFIGURATION
# RouteOne and DealerTrack Compliance
# ===========================================

# CORS - Dominios permitidos (separados por coma)
ALLOWED_ORIGINS=https://app.htownautos.com,https://htownautos.com

# ===========================================
# AWS COGNITO AUTHENTICATION
# ===========================================
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_REGION=us-east-1

# Encryption key para datos sensibles (SSN, financial data)
# ENCRYPTION_KEY=your-32-character-encryption-key-here

# ===========================================
# RATE LIMITING
# ===========================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ===========================================
# ROUTEONE CONFIGURATION
# ===========================================
# ROUTEONE_API_URL=https://api.routeone.com
# ROUTEONE_API_KEY=your-routeone-api-key
# ROUTEONE_DEALER_ID=your-dealer-id

# ===========================================
# DEALERTRACK CONFIGURATION
# ===========================================
# DEALERTRACK_API_URL=https://api.dealertrack.com
# DEALERTRACK_API_KEY=your-dealertrack-api-key
# DEALERTRACK_DEALER_ID=your-dealer-id

# ===========================================
# COMPLIANCE & AUDIT
# ===========================================
AUDIT_LOG_RETENTION_DAYS=2555
# 7 años = 2555 días (requerido por RouteOne)

# Enable/disable audit logging
AUDIT_ENABLED=true

# ===========================================
# EXTERNAL INTEGRATIONS
# ===========================================

# SIEM Integration (Splunk, Datadog, etc.)
# SIEM_ENDPOINT=https://your-siem-endpoint.com
# SIEM_API_KEY=your-siem-api-key

# Email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password

# ===========================================
# OPTIONAL FEATURES
# ===========================================

# Enable Swagger documentation in production
SWAGGER_ENABLED=true

# Log level (error, warn, log, debug, verbose)
LOG_LEVEL=log

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=0



# ===========================================
# TWILIO CONFIGURATION
# ===========================================

TWILIO_SID=your_twilio_account_sid_here
TWILIO_SECRET=your_twilio_auth_token_here
# Account SID/Auth Token pair — required for X-Twilio-Signature validation and for downloading MMS media (Twilio media URLs need Basic Auth). Independent of the API Key pair above.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=


#API URL
API_BASE_URL=https://localhost:3000

# ===========================================
# AUCTION MONITOR (headless live-sale browser)
# ===========================================
# AutoBidMaster account the browser signs in with
ABM_USER=your_autobidmaster_email
ABM_PASS=your_autobidmaster_password
# Shared secret for POST /auction-sale-results/ingest (the monitor posts there)
AUCTION_INGEST_API_KEY=your_ingest_secret
MONITOR_HEADLESS=true
MONITOR_PROFILE_DIR=./.abm-profile
# Path to the Chromium/Chrome binary (set to /usr/bin/chromium in the container)
# PUPPETEER_EXECUTABLE_PATH=

# ===========================================
# CANALES DE CHAT (Settings -> Integraciones)
# ===========================================
# Un unico bot para todos los tenants: cada uno lo vincula con un codigo, y asi
# nunca se le pide un secreto propio. Sin estas variables Telegram no aparece
# como opcion; Discord funciona sin configurar nada.
#
# Puesta en marcha:
#   1. Crea el bot con @BotFather y copia el token.
#   2. Inventa un secreto para el webhook (openssl rand -hex 32).
#   3. Registra el webhook en Telegram:
#      curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#        -d "url=https://api.htownautos.com/api/v1/notification-channels/telegram/webhook" \
#        -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# App de Slack (api.slack.com/apps). Scopes: chat:write, channels:read.
# Redirect URL: https://app.htownautos.com/dashboard/settings/integrations
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ===========================================
# SOCIAL SUITE (Buffer clone + unified inbox)
# ===========================================
# Apps del operador: los tenants nunca escriben un id/secreto, solo dan click
# en "Conectar". Sin la clave de una plataforma, esa plataforma se deshabilita
# con un 400 claro ("X no esta configurado") en vez de romper el arranque.
SOCIAL_TOKEN_KEY=  # REQUERIDA — 32 bytes en base64 (openssl rand -base64 32); cifra tokens/contrasenas de apps en SocialAccount.encryptedSecrets
OAUTH_STATE_SECRET=  # REQUERIDA — HMAC del state firmado del flujo OAuth de conexion (10 min de vigencia)

# Facebook Login (tambien cubre Instagram via FB Login, y el fallback de WhatsApp Embedded Signup)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram Login directo (preferido sobre FB Login cuando no hace falta una Page)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Threads OAuth
THREADS_APP_ID=
THREADS_APP_SECRET=
# TikTok Login Kit
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Google OAuth para YouTube (cae a GOOGLE_CLIENT_ID/SECRET si faltan estas)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Google Business Profile (cae a GOOGLE_CLIENT_ID/SECRET si faltan estas)
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn OAuth (miembro + pagina de empresa)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Pinterest OAuth
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# X (Twitter) OAuth 2.0 PKCE
X_CLIENT_ID=
X_CLIENT_SECRET=
# WhatsApp Embedded Signup — Configuration ID de Meta (usa el mismo FACEBOOK_APP_ID/SECRET)
WHATSAPP_CONFIG_ID=
# Verifica el webhook GET de Meta (Facebook/Instagram/WhatsApp) en /social/webhooks/meta
META_WEBHOOK_VERIFY_TOKEN=
# Version de Graph API a usar; si se omite, se usa la estable vigente al momento de llamar
META_GRAPH_VERSION=
# Modelo para /social/ai/compose y /social/ai/reply-suggestion; si se omite, usa el de ai-chat
SOCIAL_AI_MODEL=
# Host publico que Twilio/Meta llaman de vuelta (firma de webhooks, deep links)
PUBLIC_API_URL=https://api.htownautos.com
# Apagon de emergencia: deshabilita la validacion de X-Twilio-Signature en los webhooks de SMS
TWILIO_VALIDATE_SIGNATURE=true
